<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Prayer for Nobuko</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Font 'Inter' for a clean, modern UI -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* A subtle background pattern for the chat area */
        .chat-bg {
            background-color: #f8f9fa;
        }
        /* Blinking cursor animation */
        .blink {
            animation: blink-animation 1s steps(2, start) infinite;
        }
        @keyframes blink-animation {
            to {
                visibility: hidden;
            }
        }
        /* This CSS rule is crucial for making the \n (newline)
           characters from the JavaScript string render as line breaks */
        #prayer-text {
            white-space: pre-wrap;
        }
    </style>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">

    <!-- 
      This is the main "phone" or "chat app" window.
      It's fully responsive, taking the full width on small screens
      and constraining to a 'max-w-md' (medium size) on larger screens.
    -->
    <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden border border-gray-200">
        
        <!-- Header Bar: Shows who the chat is with -->
        <header class="bg-white border-b border-gray-200 p-4 flex items-center space-x-3">
            <!-- Profile initial "N" -->
            <div class="w-11 h-11 rounded-full bg-orange-400 text-white flex items-center justify-center text-xl font-semibold flex-shrink-0">
                N
            </div>
            <div>
                <h1 class="text-lg font-bold text-gray-800">To: Nobuko</h1>
                <!-- Dynamic status to enhance the "live" feel -->
                <p class="text-sm text-green-500">Sending prayer...</p>
            </div>
        </header>

        <!-- Chat Message Area -->
        <div class="h-[600px] overflow-y-auto p-6 space-y-4 chat-bg">
            
            <!-- Timestamp (using the context you provided) -->
            <div class="text-center text-xs text-gray-400 uppercase font-medium py-2">
                Friday, 3:17 AM (EAT)
            </div>

            <!-- The Prayer Message Bubble -->
            <!-- 'flex justify-end' pushes the bubble to the right (like a "sent" message) -->
            <div class="flex justify-end">
                <div class="relative max-w-xs md:max-w-sm p-5 rounded-3xl rounded-br-lg shadow-lg text-white 
                            bg-gradient-to-br from-orange-400 to-red-400">
                    
                    <!-- 
                      This span will be populated by the JavaScript.
                      The blinking cursor will be right after it.
                    -->
                    <span id="prayer-text"></span>
                    <span id="cursor" class="blink relative top-0.5">|</span>
                    
                </div>
            </div>
            
            <!-- A "typing" indicator for the *other* person (Nobuko) 
                 to make the chat feel more alive, even though the prayer is from you.
                 It will disappear when the prayer is "sent". -->
            <div id="typing-indicator" class="flex justify-start">
                <div class="p-3 rounded-3xl rounded-bl-lg bg-gray-200 text-gray-600">
                    <span class="font-medium">Nobuko is typing</span>
                    <span class="blink">...</span>
                </div>
            </div>

        </div>

        <!-- Footer: Mock text input area to complete the app look -->
        <footer class="bg-white border-t border-gray-200 p-4 flex items-center">
            <input 
                type="text" 
                placeholder="Message..." 
                class="w-full bg-gray-100 rounded-full py-2 px-4 focus:outline-none text-gray-700"
                disabled
            />
            <button class="ml-3 text-gray-400 p-2 rounded-full" disabled>
                <!-- Send icon (dimmed) -->
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                </svg>
            </button>
        </footer>
    </div>

    <script>
        // The full text of the prayer.
        // Using backticks (`) allows us to have line breaks.
        const prayerText = `Dear Lord,

I lift up Nobuko into Your loving hands. Thank You for her kind heart, her light, and the joy she brings into the lives of others. Lord, please cover her, her family, and her friends with Your divine protection. Let no harm come near them. Surround them with peace, joy, and unshakable love.

May Nobuko's smile never fade. May her days be filled with laughter, purpose, and comfort. Shield her from the pain caused by people with heavy hearts or unkind intentions. Let her soul stay gentle and bright, just the way You made it.

Bless her home, her dreams, and every step she takes. Let her feel Your presence even when she feels alone. May she always know she is deeply loved, and that she matters.

And Lord, I humbly pray for more life—for strength, for time to keep loving the beautiful souls You’ve placed in my journey. Thank You for connecting me with such an angel.

Amen. 🙏🏽🧡`;

        // We use the spread operator [...] to turn the string into an array.
        // This correctly handles multi-byte characters like emojis (🙏🏽🧡).
        const textChars = [...prayerText];
        let i = 0;
        const speed = 50; // Milliseconds per character. Lower is faster.
        
        // Get the HTML elements we need to interact with
        const textElement = document.getElementById('prayer-text');
        const cursorElement = document.getElementById('cursor');
        const chatArea = document.querySelector('.chat-bg');
        const typingIndicator = document.getElementById('typing-indicator');

        // This function "types" the prayer
        function typePrayer() {
            if (i < textChars.length) {
                // Add the next character to the span
                textElement.textContent += textChars[i];
                i++;
                
                // Automatically scroll the chat window to the bottom
                // so the typing is always visible
                chatArea.scrollTop = chatArea.scrollHeight;
                
                // Call this function again after 'speed' milliseconds
                setTimeout(typePrayer, speed);
            } else {
                // Typing is finished
                cursorElement.style.display = 'none'; // Hide the cursor
                
                // Remove the "Nobuko is typing" indicator
                if (typingIndicator) {
                    typingIndicator.style.display = 'none';
                }
            }
        }
        
        // Wait for the page to be fully loaded
        window.addEventListener('load', () => {
            // Start the typing animation after a short delay (1.2 seconds)
            // to let the user see the "typing" indicator first.
            setTimeout(() => {
                if (typingIndicator) {
                    // We hide the "typing" indicator right before the
                    // "sent" message bubble starts typing.
                    typingIndicator.style.display = 'none';
                }
                // A second short delay before the prayer bubble appears
                setTimeout(typePrayer, 300);
            }, 1200);
        });
    </script>

</body>
</html>